# The Python API runs on Render now, not Vercel. Keep it out of the
# Vercel deployment so Vercel doesn't try to build it as a function.
api/
lib/
requirements.txt
render.yaml
runtime.txt

# Secrets / local env
.env
.env.local
.env.*.local

# Local tooling / IDE
.vs
.claude
.vscode

# Python build artifacts
__pycache__
*.pyc
.pytest_cache

# Vercel CLI local state
.vercel
