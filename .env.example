# Copy this file to .env for local development. Do NOT commit .env.
# On Vercel, set these under Project Settings -> Environment Variables instead.

# Required: your OpenAI API key
OPENAI_API_KEY=your-openai-api-key-here

# Optional: model name (defaults to "gpt-5" in lib/yahoo_finance.py)
OPENAI_MODEL=gpt-5
